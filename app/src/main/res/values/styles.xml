<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Text -->
    <style name="Nabd.Text" parent="">
        <item name="android:fontFamily">@font/tajawal_regular</item>
        <item name="android:textColor">@color/nabd_on_surface</item>
        <item name="android:textAlignment">viewStart</item>
        <item name="android:textSize">14sp</item>
    </style>
    <style name="Nabd.Text.Headline">
        <item name="android:fontFamily">@font/tajawal_black</item>
        <item name="android:textSize">22sp</item>
        <!-- Tajawal Black glyphs sit lower than the font's reported descent -->
        <item name="android:paddingBottom">4dp</item>
    </style>
    <style name="Nabd.Text.Title">
        <item name="android:fontFamily">@font/tajawal_bold</item>
        <item name="android:textSize">17sp</item>
    </style>
    <style name="Nabd.Text.Section">
        <item name="android:fontFamily">@font/tajawal_bold</item>
        <item name="android:textSize">15sp</item>
    </style>
    <style name="Nabd.Text.Label">
        <item name="android:fontFamily">@font/tajawal_bold</item>
        <item name="android:textSize">13sp</item>
        <item name="android:layout_marginTop">18dp</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>
    <style name="Nabd.Text.Body">
        <item name="android:textColor">@color/nabd_on_surface_variant</item>
        <item name="android:lineSpacingExtra">4dp</item>
    </style>
    <style name="Nabd.Text.Caption">
        <item name="android:textColor">@color/nabd_on_surface_variant</item>
        <item name="android:textSize">12sp</item>
    </style>
    <style name="Nabd.Text.Pill">
        <item name="android:fontFamily">@font/tajawal_bold</item>
        <item name="android:textSize">11sp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingBottom">3dp</item>
    </style>

    <!-- Cards -->
    <style name="Nabd.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/nabd_surface</item>
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/nabd_container</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Nabd.Shape.Rounded" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <!-- Buttons -->
    <style name="Nabd.TextAppearance.Button" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">@font/tajawal_bold</item>
        <item name="fontFamily">@font/tajawal_bold</item>
        <item name="android:textSize">16sp</item>
    </style>
    <style name="Nabd.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/nabd_primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="iconTint">@color/white</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="iconGravity">textStart</item>
        <item name="android:textAppearance">@style/Nabd.TextAppearance.Button</item>
    </style>
    <style name="Nabd.Button.Danger" parent="Nabd.Button.Primary">
        <item name="backgroundTint">@color/nabd_emergency</item>
    </style>
    <style name="Nabd.Button.Pill" parent="Nabd.Button.Danger">
        <item name="cornerRadius">50dp</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="iconSize">18dp</item>
        <item name="iconPadding">6dp</item>
        <item name="android:textSize">13sp</item>
    </style>
    <!-- Light blue "tonal" button used for secondary actions (share, edit, SOS) -->
    <style name="Nabd.Button.Tonal" parent="Nabd.Button.Primary">
        <item name="backgroundTint">@color/nabd_container</item>
        <item name="android:textColor">@color/nabd_on_surface</item>
        <item name="iconTint">@color/nabd_on_surface</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="iconSize">20dp</item>
        <item name="iconPadding">6dp</item>
    </style>
    <style name="Nabd.Button.Small" parent="Nabd.Button.Primary">
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="iconSize">20dp</item>
        <item name="iconPadding">6dp</item>
    </style>
    <!-- Square icon-only tonal button -->
    <style name="Nabd.Button.Icon" parent="Nabd.Button.Tonal">
        <item name="android:minWidth">48dp</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="iconPadding">0dp</item>
        <item name="iconGravity">textStart</item>
    </style>
    <!-- Compact segmented sort buttons on the protocols header -->
    <style name="Nabd.Button.Toggle" parent="Widget.Material3.Button.OutlinedButton">
        <item name="backgroundTint">@color/toggle_bg</item>
        <item name="android:textColor">@color/toggle_text</item>
        <item name="iconTint">@color/toggle_text</item>
        <item name="strokeColor">@color/nabd_container_high</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:minHeight">36dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="iconSize">14dp</item>
        <item name="iconPadding">4dp</item>
        <item name="android:textAppearance">@style/Nabd.TextAppearance.Chip</item>
        <item name="android:textSize">12sp</item>
    </style>
    <style name="Nabd.Switch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="android:fontFamily">@font/tajawal_bold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/nabd_on_surface</item>
        <item name="android:minHeight">52dp</item>
        <item name="thumbTint">@color/switch_thumb</item>
        <item name="trackTint">@color/switch_track</item>
    </style>
    <style name="Nabd.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/nabd_primary</item>
        <item name="android:textAppearance">@style/Nabd.TextAppearance.Button</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- Chips -->
    <style name="Nabd.TextAppearance.Chip" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">@font/tajawal_bold</item>
        <item name="fontFamily">@font/tajawal_bold</item>
        <item name="android:textSize">13sp</item>
    </style>
    <style name="Nabd.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_bg</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="chipStrokeColor">@color/chip_stroke</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipCornerRadius">50dp</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipMinHeight">36dp</item>
        <item name="android:textAppearance">@style/Nabd.TextAppearance.Chip</item>
    </style>

    <!-- Selected state is a soft mint fill, used where a solid teal would hide coloured icons -->
    <style name="Nabd.Chip.Soft">
        <item name="chipBackgroundColor">@color/chip_bg_soft</item>
        <item name="android:textColor">@color/chip_text_soft</item>
    </style>

    <!-- Inputs -->
    <style name="Nabd.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/nabd_surface</item>
        <item name="boxStrokeColor">@color/input_stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="hintEnabled">false</item>
        <item name="startIconTint">@color/nabd_outline</item>
        <item name="endIconTint">@color/nabd_outline</item>
    </style>

    <!-- Bottom navigation -->
    <style name="Nabd.TextAppearance.Nav" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:fontFamily">@font/tajawal_bold</item>
        <item name="fontFamily">@font/tajawal_bold</item>
        <item name="android:textSize">12sp</item>
    </style>
    <style name="Nabd.BottomNav.Indicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/nabd_mint_soft</item>
    </style>
    <style name="Nabd.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="backgroundTint">@color/nabd_surface</item>
        <item name="itemIconTint">@color/nav_item_color</item>
        <item name="itemTextColor">@color/nav_item_color</item>
        <item name="itemActiveIndicatorStyle">@style/Nabd.BottomNav.Indicator</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="itemTextAppearanceActive">@style/Nabd.TextAppearance.Nav</item>
        <item name="itemTextAppearanceInactive">@style/Nabd.TextAppearance.Nav</item>
        <item name="elevation">8dp</item>
    </style>
</resources>
