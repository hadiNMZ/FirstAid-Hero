<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Nabd.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    android:layoutDirection="rtl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="top"
        android:orientation="horizontal"
        android:padding="16dp">

        <!-- Large tinted number tile with Arabic-Indic numerals -->
        <TextView
            android:id="@+id/tvStepNumber"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_tile_number"
            android:fontFamily="@font/tajawal_black"
            android:gravity="center"
            android:includeFontPadding="false"
            android:textColor="@color/nabd_primary"
            android:textSize="26sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvStepLabel"
                style="@style/Nabd.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/tajawal_bold"
                android:textColor="@color/nabd_primary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvInstruction"
                style="@style/Nabd.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/tajawal_bold"
                android:lineSpacingExtra="6dp"
                android:paddingBottom="4dp"
                android:textSize="16sp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
