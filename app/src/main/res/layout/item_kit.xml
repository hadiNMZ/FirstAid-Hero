<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Nabd.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="5dp"
    android:layout_marginBottom="5dp"
    android:layoutDirection="rtl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <!-- Product photo (kit_* in res/drawable-nodpi) or category icon -->
            <FrameLayout
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_image_box">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivKitPhoto"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                    app:shapeAppearanceOverlay="@style/Nabd.Shape.Rounded" />

                <ImageView
                    android:id="@+id/ivKitIcon"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/tvKitQtyBadge"
                    style="@style/Nabd.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="4dp"
                    android:background="@drawable/bg_badge_qty"
                    android:fontFamily="@font/tajawal_bold"
                    android:paddingStart="5dp"
                    android:paddingEnd="5dp"
                    android:textColor="@color/white"
                    android:textDirection="ltr"
                    android:textSize="10sp" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvKitName"
                        style="@style/Nabd.Text.Title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/tvKitStatus"
                        style="@style/Nabd.Text.Pill"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvKitNameEn"
                    style="@style/Nabd.Text.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAlignment="viewStart"
                    android:textDirection="ltr" />

                <TextView
                    android:id="@+id/tvKitMeta"
                    style="@style/Nabd.Text.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:drawablePadding="4dp"
                    android:fontFamily="@font/tajawal_bold"
                    android:gravity="center_vertical|start"
                    app:drawableStartCompat="@drawable/ic_inventory"
                    app:drawableTint="@color/nabd_on_surface_variant" />

                <TextView
                    android:id="@+id/tvKitRemaining"
                    style="@style/Nabd.Text.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/nabd_emergency"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <!-- Quantity stepper -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvKitExpiry"
                style="@style/Nabd.Text.Caption"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:drawablePadding="4dp"
                android:gravity="center_vertical|start"
                app:drawableStartCompat="@drawable/ic_event"
                app:drawableTint="@color/nabd_on_surface_variant" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnKitMinus"
                style="@style/Nabd.Button.Icon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/decrease"
                android:minHeight="40dp"
                android:minWidth="40dp"
                app:cornerRadius="20dp"
                app:icon="@drawable/ic_remove"
                app:iconSize="18dp" />

            <TextView
                android:id="@+id/tvKitQty"
                style="@style/Nabd.Text.Title"
                android:layout_width="36dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textAlignment="center" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnKitPlus"
                style="@style/Nabd.Button.Icon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/increase"
                android:minHeight="40dp"
                android:minWidth="40dp"
                app:backgroundTint="@color/nabd_primary"
                app:cornerRadius="20dp"
                app:icon="@drawable/ic_add"
                app:iconSize="18dp"
                app:iconTint="@color/white" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
