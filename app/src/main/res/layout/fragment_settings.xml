<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="4dp"
        android:paddingEnd="16dp">

        <TextView
            style="@style/Nabd.Text.Headline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_title" />

        <TextView
            style="@style/Nabd.Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_subtitle" />

        <!-- Database status -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Nabd.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_icon_box_teal">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_storage"
                            app:tint="@color/white" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Nabd.Text.Title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/db_status_title" />

                        <TextView
                            style="@style/Nabd.Text.Caption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/db_status_sub" />
                    </LinearLayout>

                    <TextView
                        style="@style/Nabd.Text.Pill"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_pill_green"
                        android:text="@string/db_ready_pill"
                        android:textColor="@color/nabd_green" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_card_tonal"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:id="@+id/tvProtocolCount"
                            style="@style/Nabd.Text.Headline"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/nabd_primary"
                            android:textSize="22sp" />

                        <TextView
                            style="@style/Nabd.Text.Caption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/db_protocols" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_card_tonal"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:id="@+id/tvCriticalCount"
                            style="@style/Nabd.Text.Headline"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/nabd_emergency"
                            android:textSize="22sp" />

                        <TextView
                            style="@style/Nabd.Text.Caption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/db_critical" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Protocol preferences -->
        <TextView
            style="@style/Nabd.Text.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:drawablePadding="6dp"
            android:gravity="center_vertical|start"
            android:text="@string/pref_section_protocols"
            android:textSize="15sp"
            app:drawableStartCompat="@drawable/baseline_settings_24"
            app:drawableTint="@color/nabd_primary" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Nabd.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="6dp"
                android:paddingEnd="8dp"
                android:paddingBottom="6dp">

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchKeepScreenOn"
                    style="@style/Nabd.Switch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/pref_keep_screen_on" />

                <TextView
                    style="@style/Nabd.Text.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="64dp"
                    android:layout_marginBottom="6dp"
                    android:text="@string/pref_keep_screen_on_sub" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="4dp"
                    android:background="@color/nabd_container" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchLargeText"
                    style="@style/Nabd.Switch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/pref_large_text" />

                <TextView
                    style="@style/Nabd.Text.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="64dp"
                    android:layout_marginBottom="6dp"
                    android:text="@string/pref_large_text_sub" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Reports & data -->
        <TextView
            style="@style/Nabd.Text.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:drawablePadding="6dp"
            android:gravity="center_vertical|start"
            android:text="@string/pref_section_data"
            android:textSize="15sp"
            app:drawableStartCompat="@drawable/ic_shield"
            app:drawableTint="@color/nabd_primary" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Nabd.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/Nabd.Text.Section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/pref_export_title" />

                <TextView
                    style="@style/Nabd.Text.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/pref_export_sub" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnExportCases"
                android:maxLines="1"
                app:autoSizeMaxTextSize="14sp"
                app:autoSizeMinTextSize="10sp"
                app:autoSizeTextType="uniform"
                        style="@style/Nabd.Button.Small"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/pref_export_button"
                        app:icon="@drawable/ic_share" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnClearCases"
                android:maxLines="1"
                app:autoSizeMaxTextSize="14sp"
                app:autoSizeMinTextSize="10sp"
                app:autoSizeTextType="uniform"
                        style="@style/Nabd.Button.Tonal"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="@string/pref_clear_button"
                        android:textColor="@color/nabd_emergency"
                        app:icon="@drawable/ic_delete"
                        app:iconTint="@color/nabd_emergency" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Version -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card_info"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="18dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_logo" />

            <TextView
                android:id="@+id/tvVersion"
                style="@style/Nabd.Text.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp" />

            <TextView
                style="@style/Nabd.Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/app_subtitle_nabd" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
