<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Compact Readiness summary header -->
    <com.google.android.material.card.MaterialCardView
        style="@style/Nabd.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="10dp">

            <!-- Compact Readiness Ring -->
            <FrameLayout
                android:layout_width="54dp"
                android:layout_height="54dp">

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/progressReadiness"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:max="100"
                    app:indicatorColor="@color/nabd_primary"
                    app:indicatorInset="0dp"
                    app:indicatorSize="54dp"
                    app:trackColor="@color/nabd_container"
                    app:trackCornerRadius="3dp"
                    app:trackThickness="5dp" />

                <TextView
                    android:id="@+id/tvReadiness"
                    style="@style/Nabd.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:fontFamily="@font/tajawal_black"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textAlignment="center"
                    android:textDirection="ltr"
                    android:textSize="14sp" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Nabd.Text.Headline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/kit_title"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tvKitSummary"
                    style="@style/Nabd.Text.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:textSize="12sp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnShareShortages"
                style="@style/Nabd.Button.Danger"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginStart="6dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/share"
                android:textSize="12sp"
                android:visibility="gone"
                app:icon="@drawable/ic_share" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Horizontally Scrollable Category Chips -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:clipToPadding="false"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupKit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:chipSpacingHorizontal="6dp"
            app:chipSpacingVertical="0dp"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipKitAll"
                style="@style/Nabd.Chip"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:checked="true"
                android:textSize="12sp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipKitBleeding"
                style="@style/Nabd.Chip"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:textSize="12sp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipKitBurns"
                style="@style/Nabd.Chip"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:textSize="12sp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipKitTools"
                style="@style/Nabd.Chip"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:textSize="12sp" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvKit"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="16dp"
        android:paddingTop="2dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp" />
</LinearLayout>
