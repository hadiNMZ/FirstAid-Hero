<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/nabd_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="8dp">

    <!-- Right side in RTL (Start): App Logo and Title -->
    <ImageView
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_logo" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            style="@style/Nabd.Text.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/app_title_nabd"
            android:textColor="@color/nabd_primary"
            android:textSize="20sp" />

        <TextView
            style="@style/Nabd.Text.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/app_subtitle_nabd"
            android:textColor="@color/nabd_on_surface_variant"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Left side in RTL (End): Contacts circle button and Settings gear icon -->
    <FrameLayout
        android:id="@+id/btnHeaderContacts"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/bg_circle_pink"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:contentDescription="@string/nav_contacts"
            android:src="@drawable/baseline_call_24"
            app:tint="@color/nabd_emergency" />
    </FrameLayout>

    <ImageButton
        android:id="@+id/btnHeaderSettings"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/nav_settings"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:src="@drawable/baseline_settings_24"
        app:tint="@color/nabd_on_surface" />
</LinearLayout>
