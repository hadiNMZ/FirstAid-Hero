<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Nabd.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    android:layoutDirection="rtl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Initial-letter avatar -->
            <TextView
                android:id="@+id/tvContactInitial"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_avatar_pink"
                android:fontFamily="@font/tajawal_black"
                android:gravity="center"
                android:includeFontPadding="false"
                android:textColor="@color/nabd_emergency"
                android:textSize="24sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvContactName"
                    style="@style/Nabd.Text.Headline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textSize="18sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvContactRelation"
                        style="@style/Nabd.Text.Pill"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_pill_green"
                        android:textColor="@color/nabd_green" />

                    <TextView
                        android:id="@+id/tvContactPhone"
                        style="@style/Nabd.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/tajawal_bold"
                        android:textColor="@color/nabd_on_surface"
                        android:textDirection="ltr"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnContactMore"
                style="@style/Nabd.Button.Icon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/more_options"
                android:minHeight="40dp"
                android:minWidth="40dp"
                app:backgroundTint="@color/nabd_container_low"
                app:icon="@drawable/ic_more_vert"
                app:strokeColor="@color/nabd_container"
                app:strokeWidth="1dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCallContact"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                app:iconPadding="4dp"
                android:maxLines="1"
                app:autoSizeMaxTextSize="14sp"
                app:autoSizeMinTextSize="10sp"
                app:autoSizeTextType="uniform"
                style="@style/Nabd.Button.Small"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.2"
                android:text="@string/call"
                app:icon="@drawable/baseline_call_24" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMessageContact"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                app:iconPadding="4dp"
                android:maxLines="1"
                app:autoSizeMaxTextSize="14sp"
                app:autoSizeMinTextSize="10sp"
                app:autoSizeTextType="uniform"
                style="@style/Nabd.Button.Tonal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/sos_message"
                app:icon="@drawable/ic_sms" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEditContact"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                app:iconPadding="4dp"
                android:maxLines="1"
                app:autoSizeMaxTextSize="14sp"
                app:autoSizeMinTextSize="10sp"
                app:autoSizeTextType="uniform"
                style="@style/Nabd.Button.Tonal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/edit"
                app:icon="@drawable/ic_edit" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
