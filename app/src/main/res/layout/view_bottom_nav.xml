<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="96dp"
    android:background="@color/nabd_surface"
    android:baselineAligned="false"
    android:elevation="8dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="12dp">

    <!-- 1. Rightmost in RTL (Start): SOS Siren Button -->
    <LinearLayout
        android:id="@+id/navItemSos"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_circle_pink">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription="SOS"
                android:src="@drawable/ic_siren"
                app:tint="@color/nabd_emergency" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvNavSos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="SOS"
            android:textColor="@color/nabd_emergency"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 2. Middle Part: Taller Split Pill Button (Blue: الأدلة / Red: 110 طوارئ) -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:cardCornerRadius="28dp"
        app:cardElevation="3dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <!-- Right side physically in RTL (Blue half: الأدلة) -->
            <LinearLayout
                android:id="@+id/navItemGuides"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:background="#0D47A1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="18dp">

                <ImageView
                    android:id="@+id/ivNavGuides"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@string/nav_guides"
                    android:src="@drawable/baseline_library_books_24"
                    app:tint="@color/white" />

                <TextView
                    android:id="@+id/tvNavGuides"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:includeFontPadding="false"
                    android:text="@string/nav_guides"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Left side physically in RTL (Red half: 110 طوارئ) -->
            <LinearLayout
                android:id="@+id/btnNavCall110"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:background="#C62828"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="18dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@null"
                    android:src="@drawable/baseline_call_24"
                    app:tint="@color/white" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:includeFontPadding="false"
                    android:text="@string/call_110"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 3. Leftmost in RTL (End): Cases Log Tab (السجل) -->
    <LinearLayout
        android:id="@+id/navItemCases"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/ivNavCases"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:contentDescription="@string/nav_log"
            android:src="@drawable/baseline_assignment_24"
            app:tint="@color/nabd_outline" />

        <TextView
            android:id="@+id/tvNavCases"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:singleLine="true"
            android:text="@string/nav_log"
            android:textColor="@color/nabd_outline"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
